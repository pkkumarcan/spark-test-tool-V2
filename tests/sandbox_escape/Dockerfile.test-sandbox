FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget netcat-openbsd nmap procps \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sandbox_test

WORKDIR /workspace

RUN echo "This is a test workspace file" > /workspace/test_file.txt

RUN echo "SECRET_KEY=abc123" > /workspace/.env

CMD ["python3", "-c", "print('sandbox active')"]
